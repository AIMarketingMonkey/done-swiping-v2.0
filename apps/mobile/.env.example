# Done Swiping — mobile app environment variables
# Copy this file to .env.local and fill in values for local development.
# Only EXPO_PUBLIC_* variables are bundled into the client binary.
#
# SECURITY: Only the Supabase anon key (public by design) and the public API
# URL belong here. NEVER add the Supabase service-role key — it bypasses Row
# Level Security and must stay server-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_API_URL=https://api.doneswiping.com
