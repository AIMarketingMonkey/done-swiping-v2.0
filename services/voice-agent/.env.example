# Done Swiping — Voice Agent environment variables
#
# This service reads the REPO ROOT .env file (one level up from services/voice-agent/).
# Copy .env.example → .env at the repo root and fill in the values.
# NEVER commit a .env file with real secrets.
#
# python-dotenv will search upward from services/voice-agent/ and load the
# first .env it finds (typically at the monorepo root).

# ── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Deepgram (STT) ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Anthropic (LLM brain + safety + extraction) ───────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# Model strings — verify quarterly; defaults are set in lib/config.py
BRAIN_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001

# ── Text-to-speech provider selection ────────────────────────────────────────
# elevenlabs | cartesia | ab  ("ab" = stable 50/50 split per session)
TTS_PROVIDER=elevenlabs

# ── ElevenLabs (TTS primary) ──────────────────────────────────────────────────
# Required when TTS_PROVIDER is "elevenlabs" or "ab".
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional — defaults set in lib/config.py
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Cartesia (TTS alternative — optional) ─────────────────────────────────────
# Only needed when TTS_PROVIDER is "cartesia" or "ab". Leave blank to run on
# ElevenLabs alone.
CARTESIA_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# UK/EU region (London or Frankfurt) — non-negotiable for compliance
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider is called via HTTP; dimension must be 1536 for pgvector schema
EMBEDDINGS_API_KEY=your_embeddings_api_key
EMBEDDINGS_MODEL=text-embedding-3-small
