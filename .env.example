# =============================================================================
# Done Swiping — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Keys are obtained from each provider's console (see docs/SETUP.md).
# Sensitive actions (account creation, billing, OAuth consent) are done by a
# human in the real console — agents only read back generated values.
# =============================================================================

# --- Supabase (project in London/Frankfurt region) ---------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001

# --- Voice -------------------------------------------------------------------
DEEPGRAM_API_KEY=
TTS_PROVIDER=elevenlabs        # elevenlabs | cartesia | ab
# ElevenLabs (primary TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=           # chosen companion voice (set at M2)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Cartesia (optional alternative — only if TTS_PROVIDER=cartesia|ab)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=                 # optional Gemini Live fallback

# --- Embeddings --------------------------------------------------------------
# Default: OpenAI text-embedding-3-small (1536 dims) to match the schema.
# Alternatives: Voyage, Gemini — keep the vector column at 1536 dims.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Identity / age assurance ------------------------------------------------
IDV_PROVIDER=yoti               # or persona
IDV_API_KEY=
IDV_WEBHOOK_SECRET=

# --- Payments (Stripe, web-first) --------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=            # Stripe Price ID for the premium subscription
APP_DEEP_LINK=doneswiping://     # scheme for deep-linking back from web checkout

# --- Ops ---------------------------------------------------------------------
SENTRY_DSN=
RESEND_API_KEY=
EXPO_PUSH_TOKEN=
APP_REGION=uk

# --- API service runtime -----------------------------------------------------
API_PORT=8787
# Public base URL of the API (used for building webhook URLs etc.)
API_PUBLIC_URL=http://localhost:8787
